# --- modelo Wells-Riley ---
# P = 1 - exp(-(I*q*p*t)/Q)  |  Q = vol*ACH  |  p=0.48 m³/h fixo (ASHRAE)
def wells_riley(n_inf: int, quanta: float, t_h: float, Q: float, p: float = RESP_RATE) -> float:
    if Q <= 0:
        return 1.0  # workaround: sem renovação de ar = risco máximo, evita div/0
    dose = (n_inf * quanta * p * t_h) / Q
    return 1.0 - math.exp(-dose)


def rodar_mc(n_pop: int, px: float, py: float, p_coinf: float,
            p_shift: float, cfr: float, r0: float, seed: int = 42) -> dict:
    # Monte Carlo — amostra N_ITER vezes pra capturar variabilidade estocástica
    # Binomial pra eventos discretos (infecta ou não), Poisson pra casos secundários
    rng = np.random.default_rng(seed)
    _clip = lambda v: max(0.0, min(1.0, v))  # garante [0,1] nos inputs

    casos_x   = np.zeros(N_ITER)
    casos_y   = np.zeros(N_ITER)
    coinf     = np.zeros(N_ITER)
    n_shift   = np.zeros(N_ITER)
    mortes    = np.zeros(N_ITER)
    sec       = np.zeros(N_ITER)

    for i in range(N_ITER):
        ix = rng.binomial(n=n_pop, p=_clip(px))
        iy = rng.binomial(n=n_pop, p=_clip(py))
        ic = rng.binomial(n=n_pop, p=_clip(p_coinf))

        # shift só acontece se tem coinfectado — condicionado
        ns = rng.binomial(n=ic, p=_clip(p_shift)) if ic > 0 else 0
        mt = rng.binomial(n=ns, p=_clip(cfr))     if ns > 0 else 0
        # Poisson: cada caso de shift gera R0 secundários em média
        sc = rng.poisson(lam=r0 * ns)             if ns > 0 else 0

        casos_x[i], casos_y[i], coinf[i] = ix, iy, ic
        n_shift[i], mortes[i],  sec[i]   = ns, mt, sc

    # print(f"debug seed={seed} | mean_shift={n_shift.mean():.4f} | p_coinf={p_coinf:.6f}")
    return {"x": casos_x, "y": casos_y, "coinf": coinf,
            "shift": n_shift, "mortes": mortes, "sec": sec}


def _nivel_risco(p_coinf: float, avg_shift: float):
    # TODO: revisar limiares — baseado em intuição epidemiológica, não literatura direta
    if avg_shift >= 1.0 and p_coinf > 0.001:
        return "🔴 RISCO CRÍTICO — Probabilidade real de evento de Shift", "risk-critical"
    elif avg_shift >= 0.1 or p_coinf > 0.0005:
        return "🟡 RISCO MODERADO — Cenário requer monitoramento ativo", "risk-moderate"
    return "🟢 RISCO BAIXO — Parâmetros atuais indicam risco mínimo", "risk-safe"


