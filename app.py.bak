    "Métrica":       ["Infectados X", "Infectados Y", "Coinfectados",
                      "Eventos Shift", "Mortes", "Casos Secundários"],
    "Média":         [f"{avg_x:.2f}",   f"{avg_y:.2f}",   f"{avg_coinf:.4f}",
                      f"{avg_shift:.5f}",f"{avg_mort:.5f}", f"{avg_sec:.3f}"],
    "DP":            [f"{res['x'].std():.2f}",   f"{res['y'].std():.2f}",
                      f"{std_coinf:.4f}",         f"{std_shift:.5f}",
                      f"{std_mort:.5f}",           f"{res['sec'].std():.3f}"],
    "Mín.": [f"{res[k].min():.0f}" for k in ["x","y","coinf","shift","mortes","sec"]],
    "Máx.": [f"{res[k].max():.0f}" for k in ["x","y","coinf","shift","mortes","sec"]],
    "P(>0)%": [f"{(res[k]>0).mean()*100:.2f}%" for k in ["x","y","coinf","shift","mortes","sec"]],
})
st.dataframe(df_resumo, use_container_width=True, hide_index=True)

