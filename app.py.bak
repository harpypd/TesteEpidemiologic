                unsafe_allow_html=True)
    q_x     = st.number_input("Quanta/h — X",  0.1, 1000.0, float(px_data["quanta"]), 0.5,
                              help="1 quantum infecta 63% dos expostos (1-1/e)")
    n_inf_x = st.number_input("Infectantes X", 0, 500, 2, 1)

    # patógeno Y — humano
    st.markdown('<div class="section-header">👤 Patógeno Y — Humano</div>', unsafe_allow_html=True)
    py_sel  = st.selectbox("Preset humano", list(PRESETS_PATOGENO_Y.keys()), 3,
                           help=f"{len(PRESETS_PATOGENO_Y)} patógenos na base")
    py_data = PRESETS_PATOGENO_Y[py_sel]
    st.markdown(f"<small style='color:#718096;line-height:1.5'>{py_data['info']}</small>",
                unsafe_allow_html=True)
    q_y     = st.number_input("Quanta/h — Y",  0.1, 1000.0, float(py_data["quanta"]), 0.5)
    n_inf_y = st.number_input("Infectantes Y", 0, 500, 5, 1)

    # cepa quimérica — preenche com valores do preset X quando disponível
    st.markdown('<div class="section-header">⚗️ Cepa Quimérica (Pós-Shift)</div>', unsafe_allow_html=True)
    _s_def = float(px_data.get("shift_sugerido", 0.05))
    _c_def = float(px_data.get("cfr_sugerido",   0.35))
    _r_def = float(px_data.get("r0_sugerido",    4.5))

    p_shift = st.slider("P(Shift | Coinfecção)", 0.001, 1.0, _s_def, 0.001, format="%.3f")
    cfr     = st.slider("CFR da Quimérica",      0.001, 1.0, _c_def, 0.005, format="%.3f")
    r0      = st.slider("R₀ da Quimérica",         0.5, 20.0, _r_def, 0.1,  format="%.1f")

    st.markdown("---")
    run_btn = st.button("▶ Executar Simulação", type="primary", use_container_width=True)
    st.markdown(
        f"<div style='text-align:center;color:#4a5568;font-size:0.7rem;margin-top:8px'>"
        f"MC: {N_ITER:,} iter · resp={RESP_RATE} m³/h</div>",
        unsafe_allow_html=True
    )


# --- painel principal ---
st.markdown("# 🦠 Simulador de Risco de Coinfecção Aerossólica e Antigenic Shift")
st.markdown(
    "<p style='color:#718096;font-size:0.9rem;margin-top:-12px'>"
    "Wells-Riley + Monte Carlo · Risco de Reassortamento Viral em Ambientes Confinados"
    "</p>", unsafe_allow_html=True
