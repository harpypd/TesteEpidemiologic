    unsafe_allow_html=True
)

# --- cálculos base (Wells-Riley) ---
# Q = vol * ACH, simples assim
Q      = vol * ach
px     = wells_riley(n_inf_x, q_x, t_exp, Q)
py     = wells_riley(n_inf_y, q_y, t_exp, Q)
p_coinf = px * py   # independência entre os dois aerossóis — simplificação válida pra mistura homogênea
# print(f"debug: Q={Q:.1f} | px={px:.4f} | py={py:.4f} | p_coinf={p_coinf:.6f}")

st.markdown("### 📐 Parâmetros Base — Wells-Riley")
c1, c2, c3, c4 = st.columns(4)
with c1: st.metric("Vazão Q", f"{Q:,.0f} m³/h", help="Q = Volume × ACH")
with c2: st.metric("P(inf X)", f"{px:.4f}",      delta=f"{px*100:.2f}%",      delta_color="inverse")
with c3: st.metric("P(inf Y)", f"{py:.4f}",      delta=f"{py*100:.2f}%",      delta_color="inverse")
with c4: st.metric("P(coinfecção)", f"{p_coinf:.6f}", delta=f"{p_coinf*100:.4f}%", delta_color="inverse")

with st.expander("📐 Fórmula Wells-Riley"):
    st.markdown(
        '<div class="formula-box">'
        'Q = Volume × ACH<br><br>'
        'P_i = 1 − exp[ −(I·q·p·t) / Q ]   |   p = 0.48 m³/h (ASHRAE)<br><br>'
        'P_coinf = P_X × P_Y  (independência dos eventos)<br>'
        'Shift ~ Binomial(coinf, p_shift) · Sec ~ Poisson(R₀ · n_shift)'
        '</div>', unsafe_allow_html=True
    )

st.markdown('<hr style="border:1px solid rgba(99,179,237,0.15);margin:24px 0"/>', unsafe_allow_html=True)

# --- Monte Carlo ---
_seed = np.random.randint(0, 99999) if run_btn else 42
res   = rodar_mc(n_pop, px, py, p_coinf, p_shift, cfr, r0, seed=_seed)

# médias e desvios — uso direto daqui pra baixo
avg_x    = res["x"].mean();     avg_y   = res["y"].mean()
avg_coinf= res["coinf"].mean(); std_coinf= res["coinf"].std()
avg_shift= res["shift"].mean(); std_shift= res["shift"].std()
avg_mort = res["mortes"].mean();std_mort = res["mortes"].std()
avg_sec  = res["sec"].mean()

st.markdown(f"### 🎲 Monte Carlo — {N_ITER:,} iterações")

lbl_risco, cls_risco = _nivel_risco(p_coinf, avg_shift)
st.markdown(f'<div class="{cls_risco}">{lbl_risco}</div>', unsafe_allow_html=True)

ca, cb, cc = st.columns(3)
cd, ce, cf = st.columns(3)
with ca: st.metric("Infectados X",        f"{avg_x:.1f}")
with cb: st.metric("Infectados Y",        f"{avg_y:.1f}")
with cc: st.metric("Coinfectados",        f"{avg_coinf:.2f} ± {std_coinf:.2f}")
with cd:
    st.metric("Eventos de Shift", f"{avg_shift:.3f} ± {std_shift:.3f}",
              delta=f"P(≥1 shift) = {(res['shift']>0).mean()*100:.1f}%", delta_color="inverse")
with ce: st.metric("Mortes Iniciais",     f"{avg_mort:.3f} ± {std_mort:.3f}")
with cf: st.metric("Casos Secundários",   f"{avg_sec:.1f}")

st.markdown('<hr style="border:1px solid rgba(99,179,237,0.15);margin:24px 0"/>', unsafe_allow_html=True)

# --- gráficos ---
st.markdown("### 📊 Distribuição Estocástica ao Longo das Iterações")
idx = range(1, N_ITER + 1)

st.markdown("#### Infecções Primárias por Patógeno")
st.caption("Variabilidade estocástica de X (zoonótico) e Y (humano) — dispersão reflete estocasticidade da transmissão aerossólica.")
df_inf = pd.DataFrame({"X (Zoonótico)": res["x"], "Y (Humano)": res["y"]}, index=idx)
df_inf.index.name = "Iteração"
st.line_chart(df_inf, use_container_width=True, height=260)

st.markdown("#### Coinfectados vs. Eventos de Shift")
st.caption("Diferença entre as curvas = probabilidade de reassortamento bem-sucedido dado a coinfecção.")
df_co = pd.DataFrame({"Coinfectados": res["coinf"], "Eventos de Shift": res["shift"]}, index=idx)
df_co.index.name = "Iteração"
st.line_chart(df_co, use_container_width=True, height=260)

st.markdown("#### Impacto Pandêmico — Mortes e Casos Secundários")
st.caption("Poisson(R₀·n_shift) captura super-disseminação estocástica — cauda longa é o que mais importa aqui.")
df_imp = pd.DataFrame({"Mortes": res["mortes"], "Casos Sec.": res["sec"]}, index=idx)
df_imp.index.name = "Iteração"
st.line_chart(df_imp, use_container_width=True, height=260)

st.markdown("#### Histograma — Distribuição de Eventos de Shift")
st.caption("Concentração em zero é esperada — a cauda direita é o cenário de atenção em biossegurança.")
_max_s = int(res["shift"].max()) + 1
_hc, _hb = np.histogram(res["shift"], bins=min(30, max(10, _max_s)))
df_hist = pd.DataFrame({"Freq.": _hc}, index=[f"{b:.1f}" for b in _hb[:-1]])
df_hist.index.name = "Nº de Shifts"
st.bar_chart(df_hist, use_container_width=True, height=220)

